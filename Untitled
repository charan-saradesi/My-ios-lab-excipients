+//
+//  ForecastCell.swift
+//  weather
+//
+//  Created by shiro on 22/04/26.
+//
+
+import UIKit
+import Foundation
+
+class ForecastCell: UITableViewCell {
+    @IBOutlet weak var dayLabel: UILabel!
+    @IBOutlet weak var iconView: UIImageView!
+    @IBOutlet weak var minMaxLabel: UILabel!
+    @IBOutlet weak var tempBar: UIProgressView!
+
+    func configure(day: String, min: Double, max: Double, icon: String) {
+        dayLabel.text = day
+        minMaxLabel.text = "\(Int(min))° / \(Int(max))°"
+        tempBar.progress = Float((max - min) / 40.0)
+        tempBar.progressTintColor = .systemTeal
+        loadIcon(icon)
+    }
+
+    func loadIcon(_ icon: String) {
+        guard let url = URL(string: "https://openweathermap.org/img/wn/\(icon)@2x.png") else { return }
+        Task {
+            guard let (data, _) = try? await URLSession.shared.data(from: url) else { return }
+            await MainActor.run { self.iconView.image = UIImage(data: data) }
+        }
+    }
+}
